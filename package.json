{
  "name": "manychat",
  "version": "0.1.0",
  "description": "CLI-first ManyChat toolkit for agents and operators, with optional MCP compatibility",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "manychat": "dist/index.js",
    "manychat-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:mcp:http": "node dist/mcp/http-entry.js",
    "start:mcp:stdio": "node dist/index.js mcp serve --transport stdio",
    "web:dev": "pnpm -C apps/web run dev",
    "web:build": "pnpm -C apps/web run build",
    "web:start": "pnpm -C apps/web run start",
    "web:lint": "pnpm -C apps/web run lint",
    "web:test": "pnpm -C apps/web run test",
    "convex:dev": "pnpm -C apps/web run convex:dev",
    "convex:deploy": "pnpm -C apps/web run convex:deploy",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "cli",
    "manychat",
    "ai",
    "chatbot",
    "automation",
    "model-context-protocol"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/WIZNEOAI/Manychat-MCP.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^4.21.0",
    "ioredis": "^5.4.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

{
  "name": "mcp-manychat",
  "version": "0.1.0",
  "description": "CLI-first ManyChat toolkit for agents and operators, with optional MCP compatibility",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "manychat": "dist/index.js",
    "manychat-mcp": "dist/index.js",
    "mcp-manychat": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.es.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:publish": "rm -rf dist && tsc --sourceMap false",
    "prepack": "pnpm run build:publish",
    "start": "node dist/index.js",
    "start:mcp:http": "node dist/mcp/http-entry.js",
    "start:mcp:stdio": "node dist/index.js mcp serve --transport stdio",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "cli",
    "manychat",
    "ai",
    "chatbot",
    "automation",
    "model-context-protocol"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/WIZNEOAI/Manychat-MCP.git"
  },
  "homepage": "https://mc-mcp.wizneo.org",
  "bugs": {
    "url": "https://github.com/WIZNEOAI/Manychat-MCP/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

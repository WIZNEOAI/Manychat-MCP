{
  "name": "manychat-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP Server for ManyChat — let AI agents manage your ManyChat account",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "manychat-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "manychat",
    "ai",
    "chatbot",
    "automation",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnosix/manychat-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^4.21.0",
    "ioredis": "^5.4.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

# Your ManyChat API Key (required for API-key mode)
# Generate at: ManyChat > Settings > API > Generate your API Key
MANYCHAT_API_KEY=your_manychat_api_key_here

# Server port (Railway assigns this automatically)
PORT=3000

# Transport mode: "stdio" for local CLI, "http" for remote/Railway
MCP_TRANSPORT=stdio

# Public base URL (required for OAuth mode; Railway sets this via your domain)
# BASE_URL=https://your-app.up.railway.app

# Environment
NODE_ENV=development

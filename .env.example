# --- CLI / local MCP ---
MANYCHAT_API_KEY=your_manychat_api_key_here
PORT=3000
MCP_TRANSPORT=stdio
NODE_ENV=development

# Optional ManyChat API base (testing/mocks)
# MANYCHAT_API_BASE_URL=https://api.manychat.com/fb

# --- Remote MCP HTTP gateway ---
# MCP_REMOTE_AUTH=manychat_header | oauth | hosted_token
MCP_REMOTE_AUTH=manychat_header
MCP_BASE_URL=https://your-mcp-public-host.example.com

# Direct key on server (header mode) or omit and use X-ManyChat-API-Key from clients
# MANYCHAT_API_KEY=mc_...

# Hosted control plane (gateway → Vercel/Next.js). Must match MCP_INTERNAL_SHARED_SECRET on web.
# MCP_REMOTE_AUTH=hosted_token
# HOSTED_CONTROL_PLANE_URL=https://your-app.vercel.app
# HOSTED_CONTROL_PLANE_SECRET=long-random-shared-secret

# OAuth mode (production needs Redis)
# OAUTH_STORE=memory
# REDIS_URL=redis://localhost:6379
# OAUTH_AUTH_CODE_TTL_SEC=300
# OAUTH_ACCESS_TOKEN_TTL_SEC=3600
# OAUTH_REFRESH_TOKEN_TTL_SEC=2592000

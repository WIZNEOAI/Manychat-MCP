# Your ManyChat API Key (required for API-key mode)
# Generate at: ManyChat > Settings > API > Generate your API Key
MANYCHAT_API_KEY=your_manychat_api_key_here

# Server port (Railway assigns this automatically)
PORT=3000

# Transport mode: "stdio" for local CLI, "http" for remote/Railway
MCP_TRANSPORT=stdio

# Optional override for ManyChat API base URL (useful for testing/mocks)
# MANYCHAT_API_BASE_URL=https://api.manychat.com/fb

# Public base URL (required for OAuth mode; Railway sets this via your domain)
# BASE_URL=https://your-app.up.railway.app

# OAuth storage backend: "memory" (dev) or "redis" (production recommended)
OAUTH_STORE=memory

# Redis URL (required when OAUTH_STORE=redis)
# REDIS_URL=redis://localhost:6379

# OAuth token/code expiration controls (seconds)
OAUTH_AUTH_CODE_TTL_SEC=300
OAUTH_ACCESS_TOKEN_TTL_SEC=3600
OAUTH_REFRESH_TOKEN_TTL_SEC=2592000

# Environment
NODE_ENV=development

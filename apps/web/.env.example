# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex — https://dashboard.convex.dev (also set CLERK_JWT_ISSUER_DOMAIN & deploy key there)
NEXT_PUBLIC_CONVEX_URL=

# Convex dashboard (server env, not Next.js): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# STRIPE_PRO_PRICE_ID (Stripe Price id for $20/mo subscription), PUBLIC_APP_URL (site origin for Checkout return URLs)

# Optional: override GitHub links in the web shell (forks)
# NEXT_PUBLIC_GITHUB_REPO_BASE=https://github.com/your-org/your-fork

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex — https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=
# In Convex dashboard (Functions → Settings): JWT issuer for Clerk "convex" template
# CLERK_JWT_ISSUER_DOMAIN=

# Hosted control plane (Vercel / Next.js server env)
MCP_INTERNAL_SHARED_SECRET=
VAULT_MASTER_KEY=
VAULT_KEY_VERSION=v1

# Public MCP gateway URL shown in dashboard snippets (no trailing path if your client adds /mcp)
NEXT_PUBLIC_MCP_HTTP_URL=https://mcp.yourdomain.com/mcp

# Optional: validate keys against real ManyChat (default API URL if unset)
# MANYCHAT_API_BASE_URL=https://api.manychat.com/fb

# Optional: override GitHub links in the web shell
# NEXT_PUBLIC_GITHUB_REPO_BASE=https://github.com/your-org/your-fork

# --- Convex environment variables (set in Convex dashboard, not always in Next.js) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_ANNUAL_PRICE_ID=
# PUBLIC_APP_URL=https://your-app.vercel.app

# Optional email (Resend)
# RESEND_API_KEY=
